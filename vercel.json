{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.googletagmanager.com 'sha256-7JOeoHcfulY36J2GWYkaISmKs098aW/oV4mOfL3aKAQ=' 'sha256-sIw1ogizpQQhzaZtUOzQlWCi2AOeDJ+Mu9wyNbAEoZ8='"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
